# ═══════════════════════════════════════════════════════════════════════════
#  La forma correcta, cuando de verdad necesitas un secreto AL CONSTRUIR
#  (por ejemplo, un token para bajar un paquete privado).
#
#    DOCKER_BUILDKIT=1 docker build -f Dockerfile.secreto \
#      --secret id=llave,env=LLAVE -t sin-fuga .
#    docker history --no-trunc sin-fuga | grep sk_vive   → no encuentra nada
#
#  El secreto se monta solo mientras corre ESE RUN y no queda en ninguna capa.
#
#  Pero la pregunta antes de todo esto es otra: ¿de verdad lo necesitas al
#  construir? Casi nunca. Casi siempre es una variable de entorno en tiempo
#  de ejecución, y entonces no toca la imagen jamás.
# ═══════════════════════════════════════════════════════════════════════════

FROM alpine:3.21

RUN --mount=type=secret,id=llave \
    cat /run/secrets/llave > /dev/null && \
    echo "usé la llave sin dejar rastro"

CMD ["echo", "esta imagen nunca vio el secreto"]
